# ==============================================================================
# SAARTHI Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your Supabase project credentials.
# Run the migrations located in 'migrations/' in your Supabase SQL Editor.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase Project Configuration (Obtain from your Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE

# Supabase Service Role Key (Keep strictly confidential! Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Supabase Anon / Public Key (Used for public token validation)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Optional PostgreSQL Direct Connection String (For migrations or direct pooling)
# Example: postgresql://postgres.xyz:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING_HERE

# Rate Limiting & Security Defaults
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
